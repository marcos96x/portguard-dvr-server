# Porta e bind da API de gestão (este projeto)
PORT=3000
HOST=0.0.0.0

# Chave obrigatória para as rotas /api/* (envie no header X-API-Key)
API_KEY=troque-por-uma-chave-longa-e-aleatoria

# go2rtc local (usado pelo servidor para criar/apagar streams)
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_USERNAME=admin_api
GO2RTC_PASSWORD=CHANGE_ME_GO2RTC_PASSWORD

# URL pública do go2rtc, usada nas URLs devolvidas ao app
# Em produção, use o HTTPS do proxy (Nginx/Caddy), por exemplo:
# PUBLIC_GO2RTC_URL=https://cameras.seu-dominio.com
PUBLIC_GO2RTC_URL=http://127.0.0.1:1984

# Intervalo para recriar no go2rtc os streams salvos (ele esquece tudo ao reiniciar)
SYNC_INTERVAL_MS=30000

# Pasta do dvrs.json (padrão: ./data)
# DATA_DIR=/var/lib/portguard-dvr-server

# Origem permitida se o painel/webapp chamar esta API direto do navegador
# CORS_ORIGIN=https://app.seu-dominio.com
